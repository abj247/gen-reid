# Copy to .env for local development. None of these are required to run locally.

# Postgres in deployment. Omit for local development and a SQLite file is used instead.
# DATABASE_URL=postgresql://user:pass@host/dbname

# Where the browser fetches video. Leave empty locally and the app serves the encoded
# files itself. In deployment this MUST point at object storage: serving video from the
# app exhausts a free tier's egress allowance within a few hundred sessions.
# VIDEO_BASE_URL=https://media.example.com/persistqa

# Author mode is unreachable unless this is set. Use a long random string.
# AUTHOR_KEY=
# AUTHOR_NAMES=author-1,author-2

# Set to any non-empty value when serving over HTTPS.
# COOKIE_SECURE=1

# Must match the salt used by prepare/build_pools.py, or media URLs will not resolve.
# PERSISTQA_POOL_SALT=persistqa-human-study-v1
