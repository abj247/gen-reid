# ---------------------------------------------------------------------------
# Large artefacts. None of these are required to reproduce the paper from
# source; every one is regenerated by a documented command.
# ---------------------------------------------------------------------------

# Vendored third-party model checkouts (see docs/EXTERNAL_MODELS.md)
external/

# Model weights and caches
weights/
*.pt
*.pth
*.safetensors
.cache/
wandb/

# Rendered clip sets and precomputed indices (regenerate: see solutions/*/README.md)
conditioned_keyframes/
conditioned/
solutions/cairn/index/

# Evaluation outputs
results_baseline/
results_video_v2/
results/
solutions/**/results/
benchmark/**/results/

# Cluster logs
logs/
slurm-*.out
*.out
*.err

# Superseded experiment trees kept on disk but out of the repo
archive/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
._*
.idea/
.vscode/

# Local credentials and machine-local state. Never commit.
.secrets
.gemini_key
.wandb_key
.claude/
.pytest_cache/

# Regenerable analysis substrate. Rebuild with:
#   python -m solutions.shared.analysis.dump_selections
#   python -m solutions.shared.analysis.widen_windows
# The small *_stats*.json are kept, so the figures regenerate without this pass.
solutions/shared/analysis/*.jsonl

# Paper working files. The submission source lives in paper/iclr2026_submission/.
paper/persistqa_overleaf.zip
paper/iclr2026/figures_backup_0803/

# Legacy duplicates kept at the repository root for in-flight jobs only.
# See docs/MAINTENANCE.md; remove once the evaluation queue is empty.
/eval_conditioned.py
/evaluate_vlm_bm.py
/probe_video_judge_v2.py
/gen_keyframe_clips.py
/run_kf_eval.slurm
/kf_queue_feeder.sh
/combined_all_hard_v3_retagged.json
/video_id_mapping.json

# Human study: local runtime artefacts. pools.json IS committed (it is the frozen pool);
# the prepared videos and the database are regenerated or live in managed services.
humanstudy/.venv/
humanstudy/data/video/
humanstudy/*.db
humanstudy/.env
